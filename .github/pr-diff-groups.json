[
  {
    "name": "Extension",
    "match": ["extension/**"],
    "children": [
      { "name": "Third-party", "match": ["extension/third_party/**"] },
      { "name": "Source", "fallback": true }
    ]
  },
  { "name": "Tests", "match": ["tests/**"] },
  { "name": "Docs", "match": ["docs/**", "**/*.md"] },
  { "name": "CI", "match": [".github/**"] },
  { "name": "Tooling", "match": ["tools/**", "scripts/**", "*.sh"] }
]
